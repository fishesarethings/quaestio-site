# Quaestio bot configuration for your own server/host.
# Copy this file to `.env` (next to bot.py) and fill in the values.

# REQUIRED — your Discord bot token from the Developer Portal (Bot > Reset Token)
BOT_TOKEN=your-bot-token-here

# Ollama location. Default is this machine; to host the model on ANOTHER
# computer (Windows/Linux/macOS) over your network, point here instead:
#   OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which model to use. Check `ollama list`. Good picks for weak hosts:
#   qwen2.5:0.5b (0.4GB, fastest)   qwen2.5:1.5b (1GB, smart/light — default)
#   qwen3:1.7b (1.2GB, smartest small)   llama3.2 (2GB, balanced)   gemma2 (5.4GB, smartest)
# All of these are permissive open licenses (Apache 2.0 / Llama / Gemma) —
# fine to self-host.
OLLAMA_MODEL=qwen2.5:1.5b

# Seconds to wait for an AI reply before giving up (default 120)
OLLAMA_TIMEOUT=120

# Where the SQLite database lives (default: next to bot.py)
# DB_PATH=quaestio.db

# Warnings before auto-kick (default 3)
# WARN_LIMIT=3

# Rich Presence art key — must match the asset uploaded in the Developer Portal
RPC_LARGE_IMAGE=logo
# RPC_SMALL_IMAGE=wrench

# --- Community pool (optional) -----------------------------------------------
# POOL_BROKER_URL is the central Quaestio community broker. Set it and your box
# registers with the shared bot when you join the pool; leave unset to register
# in your own local pool instead. Filled in automatically after you join.
# POOL_BROKER_URL=https://admin.quaestio.online
# POOL_JOIN_KEY=
# POOL_NODE_ID=
# POOL_NODE_SECRET=