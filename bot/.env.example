# Quaestio bot configuration for your own server/host.
# Copy this file to `.env` (next to bot.py) and fill in the values.

# REQUIRED — your Discord bot token from the Developer Portal (Bot > Reset Token)
BOT_TOKEN=your-bot-token-here

# Ollama location (usually already correct). Ollama must be running.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which local model to use. Check `ollama list`. Good picks for most machines:
#   llama3.2 (2GB, balanced)   tinyllama (0.6GB, fast)   gemma2 (5.4GB, smartest)
OLLAMA_MODEL=llama3.2

# Seconds to wait for an AI reply before giving up (default 120)
OLLAMA_TIMEOUT=120

# Where the SQLite database lives (default: next to bot.py)
# DB_PATH=quaestio.db

# Warnings before auto-kick (default 3)
# WARN_LIMIT=3

# Rich Presence art key — must match the asset uploaded in the Developer Portal
RPC_LARGE_IMAGE=logo
# RPC_SMALL_IMAGE=wrench